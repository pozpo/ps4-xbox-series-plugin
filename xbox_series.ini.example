# Xbox Series X|S plugin settings
# Copy this file to  /data/GoldHEN/xbox_series.ini  on the PS4.
# Every line is optional. Delete the file to return to the defaults.
# '#' or ';' starts a comment.

# 1 = plugin active, 0 = plugin does nothing at all
enabled=1

# Dead zone of both sticks, in percent of full travel (0-40).
stick_deadzone=12

# How far a trigger must be pressed (percent, 1-100) before the game also sees
# the digital L2 / R2 button. The analog value is always passed on.
trigger_threshold=12

# What the Xbox "View" button (two squares) does:   share   or   touchpad
view_button=share

# 0 = the user who launched the game (Player 1) never gets an Xbox pad
#     (safe default: your DualShock 4 stays in charge of Player 1)
# 1 = Player 1 may use an Xbox pad when no DualShock 4 is connected
allow_player1=0

# Optional: force which players may receive Xbox pads. Numbers are the order
# in which the PS4 lists the logged-in users (1-4), e.g.  2,3
# Leave empty for automatic assignment.
xbox_players=

# 1 = answer the Xbox-button report (recommended, same as the Linux driver)
guide_ack=1

# 1 = show PS4 pop-up messages for events (connected / assigned / ...)
notifications=1

# 1 = write /data/GoldHEN/xbox_series.log  (needed to diagnose problems)
log_to_file=1

# 1 = also log the first calls of every scePad function the game makes
log_verbose=1
